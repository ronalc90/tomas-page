{
  "name": "tomas-page",
  "version": "1.0.0",
  "private": true,
  "description": "Plan de Tomás: aprende Python y SQL con talleres diarios, evaluaciones y entregables.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run db:migrate && npm run db:seed && concurrently -n api,web -c blue,green \"npm run dev -w @tomas/api\" \"npm run dev -w @tomas/web\"",
    "build": "npm run build -w @tomas/web && npm run build -w @tomas/api",
    "start": "npm run start -w @tomas/api",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "playwright test",
    "db:migrate": "npm run db:migrate -w @tomas/api",
    "db:seed": "npm run db:seed -w @tomas/api",
    "db:generate": "npm run db:generate -w @tomas/api",
    "build:pages": "VITE_DATA_MODE=local VITE_BASE=/tomas-page/ npm run build -w @tomas/web",
    "e2e:pages": "playwright test -c playwright.pages.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "type": "module"
}
